---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  personJsonLd?: boolean;
  noIndex?: boolean;
}

const { title, description, path, personJsonLd = false, noIndex = false } = Astro.props;
const canonicalUrl = new URL(path, Astro.site);
const isHome = path === '/';
const isProject = path.startsWith('/projects/');
const isAbout = path === '/about/';
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Kenechi Ucheagwu',
  alternateName: 'Kacy Ucheagwu',
  jobTitle: 'IT Operations & Systems Manager',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Jersey City',
    addressRegion: 'NJ',
  },
  sameAs: [
    'https://github.com/DaDabbler',
    'https://www.linkedin.com/in/kenechi-ucheagwu',
  ],
  email: 'mailto:kacy.ucheagwu@gmail.com',
};
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'light' || theme === 'dark') {
            document.documentElement.dataset.theme = theme;
          }
        } catch (_) {}
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!noIndex && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!noIndex && <meta property="og:url" content={canonicalUrl} />}
    <title>{title}</title>
    {personJsonLd && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell nav-wrap">
        <a class="wordmark" href="/" aria-label="Kenechi Ucheagwu, home">KU</a>
        <div class="nav-actions">
          <nav aria-label="Primary navigation">
            <a href="/" aria-current={isHome ? 'page' : undefined}>Home</a>
            <a href="/#projects" aria-current={isProject ? 'page' : undefined}>Projects</a>
            <a href="/about/" aria-current={isAbout ? 'page' : undefined}>About</a>
          </nav>
          <button class="theme-toggle" type="button" aria-label="Toggle color theme" aria-pressed="false">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <g class="theme-icon theme-icon--sun" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                <circle cx="12" cy="12" r="3.5"></circle>
                <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"></path>
              </g>
              <path class="theme-icon theme-icon--moon" d="M20 15.2A8.2 8.2 0 0 1 8.8 4a8.2 8.2 0 1 0 11.2 11.2Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-wrap">
        <div class="footer-links" aria-label="Contact links">
          <a href="mailto:kacy.ucheagwu@gmail.com">Email</a>
          <a href="https://github.com/DaDabbler">GitHub</a>
          <a href="https://www.linkedin.com/in/kenechi-ucheagwu">LinkedIn</a>
        </div>
        <p>Built with Astro. Deployed by GitHub Actions.</p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var button = document.querySelector('.theme-toggle');
        if (!button) return;

        function isDark() {
          if (root.dataset.theme) return root.dataset.theme === 'dark';
          return schemeQuery.matches;
        }

        function syncButton() {
          button.setAttribute('aria-pressed', String(isDark()));
        }

        var schemeQuery = window.matchMedia('(prefers-color-scheme: dark)');
        syncButton();
        root.classList.add('theme-ready');
        schemeQuery.addEventListener('change', function () {
          if (!root.dataset.theme) syncButton();
        });
        button.addEventListener('click', function () {
          var next = isDark() ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (_) {}
          syncButton();
        });
      })();
    </script>
  </body>
</html>
